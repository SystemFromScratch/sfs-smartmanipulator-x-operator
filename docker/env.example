# Template for docker/.env. The defaults are already built into
# docker/docker-compose.yml; copy this file to docker/.env only to change them.

# Must match the Robot PC.
ROS_DOMAIN_ID=42

# Address on smx_net (the Robot PC is 10.77.0.10).
SMX_OPERATOR_IP=10.77.0.20

# Path to the Robot PC repository, relative to docker/ or absolute.
SMX_ROBOT_PC_REPO=../../SmartManipulator-X-Robot-PC

SMX_OPERATOR_IMAGE=smartmanipulator-x-operator:jazzy

# --- GUI: Windows + Docker Desktop (WSLg), the defaults ---
# SMX_X11_DIR=/run/desktop/mnt/host/wslg/.X11-unix
# SMX_WSLG_DIR=/run/desktop/mnt/host/wslg

# --- GUI: Linux desktop with X11 (run `xhost +local:docker` once) ---
# SMX_X11_DIR=/tmp/.X11-unix
# SMX_WSLG_DIR=/tmp/smx-no-wslg
# SMX_DISPLAY=:0
# SMX_XDG_RUNTIME_DIR=/tmp

# 1 = software OpenGL (llvmpipe), always works.
SMX_LIBGL_ALWAYS_SOFTWARE=1
